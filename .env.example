# Environment: staging | production
ENV=production

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Headless mode: true | false
HEADLESS=true

# Slow motion between actions (ms) — useful for debugging
SLOW_MO=0

# Timeouts (ms)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Video recording: off | on | retain-on-failure
VIDEO_MODE=retain-on-failure

# Trace recording: off | on | retain-on-failure
TRACE_MODE=retain-on-failure

# Optional: real credentials for auth tests
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional: real booking for manage-booking tests
TEST_BOOKING_NUMBER=
TEST_BOOKING_LAST_NAME=
